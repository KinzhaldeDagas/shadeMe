<job id="BuildIncrement">
  <script language="JScript">
    <![CDATA[
    (function () {
      var fso = new ActiveXObject("Scripting.FileSystemObject");

      function getRepoRoot() {
        if (WScript.Arguments.length > 0) {
          return String(WScript.Arguments(0));
        }

        var scriptPath = WScript.ScriptFullName;
        return fso.GetParentFolderName(scriptPath);
      }

      function trimTrailingSlashes(path) {
        return path.replace(/[\\/]+$/, "");
      }

      var repoRoot = trimTrailingSlashes(getRepoRoot());
      var now = new Date();
      var year = now.getFullYear().toString();
      var revision = 0;
      for (var i = 0; i < year.length; i++) {
        revision += parseInt(year.charAt(i), 10);
      }

      var month = (now.getMonth() + 1).toString();
      if (month.length < 2) month = "0" + month;

      var day = now.getDate().toString();
      if (day.length < 2) day = "0" + day;

      var build = month + day;
      var headerPath = repoRoot + "\\BuildInfo.h";

      var header = "#ifndef __SME_BUILD_INFO_H__\r\n" +
                   "#define __SME_BUILD_INFO_H__\r\n\r\n" +
                   "#define VERSION_REVISION " + revision + "\r\n" +
                   "#define VERSION_BUILD " + build + "\r\n\r\n" +
                   "#endif /* __SME_BUILD_INFO_H__ */\r\n";

      var stream = fso.CreateTextFile(headerPath, true);
      stream.Write(header);
      stream.Close();

      WScript.Echo("Updated BuildInfo.h (VERSION_REVISION=" + revision + ", VERSION_BUILD=" + build + ")");
    })();
    ]]>
  </script>
</job>
